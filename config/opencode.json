{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "openai": {
      "apiKey": "${OPENAI_API_KEY}",
      "disabled": false
    },
    "openrouter": {
      "apiKey": "${OPENROUTER_API_KEY}",
      "baseURL": "https://openrouter.ai/api/v1",
      "disabled": false,
      "models": {
        "claude-opus-4.5": {
          "id": "anthropic/claude-opus-4.5",
          "name": "Claude Opus 4.5"
        },
        "gpt-5.2": {
          "id": "openai/gpt-5.2",
          "name": "GPT-5.2"
        },
        "gemini-3-pro": {
          "id": "google/gemini-3.0-pro",
          "name": "Gemini 3.0 Pro"
        },
        "deepseek-r1": {
          "id": "deepseek/deepseek-r1",
          "name": "DeepSeek R1"
        },
        "grok-code-fast-1": {
          "id": "x-ai/grok-code-fast-1",
          "name": "Grok Code Fast 1"
        }
      }
    }
  },
  "agents": {
    "build": {
      "model": "openrouter/x-ai/grok-code-fast-1",
      "description": "Default agent for development work with full tool access",
      "maxTokens": 8000,
      "temperature": 0
    },
    "plan": {
      "model": "openrouter/xiaomi/mimo-v2-flash:free",
      "description": "Read-only agent for analysis and planning",
      "maxTokens": 8000,
      "temperature": 0,
      "permissions": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "shell": {
    "path": "/bin/bash",
    "args": ["-l"]
  }
}
